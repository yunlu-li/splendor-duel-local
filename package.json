{
  "name": "splendor-duel-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bot": "node --experimental-strip-types scripts/bot-selfplay.mjs",
    "test:bot-ui": "node --experimental-strip-types scripts/bot-ui-smoke.mjs",
    "server": "node --experimental-strip-types src/server/index.ts",
    "dev:full": "node scripts/dev-full.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.3",
    "typescript": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "fastify": "5.9.0"
  },
  "devDependencies": {
    "vitest": "4.1.9",
    "playwright": "1.61.1",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
